{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anyfreebook",
  "main": "cf-worker.mjs",
  // Run the worker near Supabase instead of near each visitor: fewer slow round trips per page
  "placement": { "mode": "smart" },
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "9c522d0e098a4ed5911fdc7ee1e34041" }
  ],
  // Replaces the crons in vercel.json (times are UTC, same as before)
  "triggers": {
    "crons": ["0 3 * * *", "0 8 * * *"]
  }
}
