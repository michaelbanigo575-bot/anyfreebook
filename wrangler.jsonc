{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anyfreebook",
  "main": "cf-worker.mjs",
  // Run the worker near Supabase instead of near each visitor: fewer slow round trips per page
  "placement": { "mode": "smart" },
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Edge-wide rate limits (shared by every worker instance), used by src/lib/rateLimit.ts
  "ratelimits": [
    { "name": "RL_TIGHT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_NORMAL", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ],
  // Lets the worker call itself to refresh cached pages
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "anyfreebook" }],
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "9c522d0e098a4ed5911fdc7ee1e34041" }
  ],
  // Replaces the crons in vercel.json (times are UTC, same as before)
  "triggers": {
    "crons": ["0 3 * * *", "0 8 * * *"]
  }
}
